---
interface Props { readonly postId: string }
const { postId } = Astro.props
---
<section class="comment-section" aria-labelledby="leave-comment"><div class="section-heading"><p class="eyebrow">Join the conversation</p><h2 id="leave-comment">Leave a comment</h2><p>Comments are held for moderation before they appear in the next site build.</p></div>
  <form class="comment-form" data-comment-form data-post-id={postId} novalidate>
    <div class="error-summary" data-error-summary tabindex="-1" hidden><strong>Please fix the following:</strong><ul></ul></div>
    <div class="form-row"><label><span>Display name <i>required</i></span><input name="displayName" autocomplete="name" maxlength="80" required aria-describedby="display-name-error" /><small id="display-name-error" data-error-for="displayName"></small></label><label><span>Website <i>optional</i></span><input name="websiteUrl" type="url" autocomplete="url" aria-describedby="website-url-error" /><small id="website-url-error" data-error-for="websiteUrl"></small></label></div>
    <label><span>Comment <i>required</i></span><textarea name="body" rows="7" minlength="1" maxlength="2000" required aria-describedby="body-error"></textarea><small id="body-error" data-error-for="body"></small></label>
    <button class="button" type="submit">Submit for moderation</button><p class="comment-status" data-comment-status role="status" aria-live="polite"></p>
  </form>
</section>
<script>
  import { Effect } from "effect"
  import { makeHeadlessClient } from "../generated/headless-client.ts"
  const headlessClient = makeHeadlessClient(window.location.origin.replace(/:\d+$/u, ":3000"))
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-comment-form]")) {
    let idempotencyKey = crypto.randomUUID()
    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      const formData = new FormData(form),
       displayName = String(formData.get("displayName") ?? "").trim(),
       websiteUrl = String(formData.get("websiteUrl") ?? "").trim(),
       body = String(formData.get("body") ?? "").trim(),
       issues = [
        ...(displayName.length === 0 ? [{ field: "displayName", message: "Enter your display name." }] : []),
        ...(websiteUrl.length > 0 && !URL.canParse(websiteUrl) ? [{ field: "websiteUrl", message: "Enter a complete website URL." }] : []),
        ...(body.length === 0 ? [{ field: "body", message: "Enter a comment." }] : [])
      ]
      for (const element of form.querySelectorAll<HTMLElement>("[data-error-for]")) {element.textContent = ""}
      const summary = form.querySelector<HTMLElement>("[data-error-summary]")!
      if (issues.length > 0) {
        summary.hidden = false
        summary.querySelector("ul")!.innerHTML = issues.map((issue) => `<li>${issue.message}</li>`).join("")
        for (const issue of issues) {form.querySelector<HTMLElement>(`[data-error-for="${issue.field}"]`)!.textContent = issue.message}
        summary.focus()
        return
      }
      summary.hidden = true
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!,
       status = form.querySelector<HTMLElement>("[data-comment-status]")!
      button.disabled = true
      status.textContent = "Submitting…"
      try {
        const receipt = await Effect.runPromise(headlessClient.submitComment(form.dataset.postId!, { body, displayName, websiteUrl: websiteUrl || null }, idempotencyKey))
        status.textContent = `Comment ${receipt.submissionId} is pending moderation.`
        form.reset()
        idempotencyKey = crypto.randomUUID()
      } catch {
        status.textContent = "Your comment could not be submitted. Your text is still here; please try again."
      } finally {
        button.disabled = false
      }
    })
  }
</script>

