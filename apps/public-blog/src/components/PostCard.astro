---
import { assetById, authorById } from "../data/public-export.ts"
import type { PublicPost } from "../generated/headless-client.ts"
interface Props { readonly post: PublicPost; readonly featured?: boolean }
const { post, featured = false } = Astro.props,
 author = authorById.get(post.author),
 asset = post.featuredAsset === null ? undefined : assetById.get(post.featuredAsset)
---
<article class:list={["post-card", { featured }]}>
  {asset?.localPath && <a class="post-image" href={`/posts/${post.slug}/`} tabindex="-1"><img src={asset.localPath} alt={post.featuredAlternativeText ?? ""} width={asset.metadata.width} height={asset.metadata.height} /></a>}
  <div class="post-card-body"><p class="post-meta"><time datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</time>{author && <> · <a href={`/authors/${author.slug}/`}>{author.name}</a></>}</p><h2><a href={`/posts/${post.slug}/`}>{post.title}</a></h2><p>{post.excerpt}</p><a class="read-link" href={`/posts/${post.slug}/`}>Read field note <span aria-hidden="true">→</span></a></div>
</article>

