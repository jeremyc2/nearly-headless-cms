---
import PostCard from "../../components/PostCard.astro"
import { publicExport } from "../../data/public-export.ts"
import SiteLayout from "../../layouts/SiteLayout.astro"
---
<SiteLayout title="Archive"><header class="listing-header"><div class="shell"><p class="eyebrow">Every field note</p><h1>The archive</h1><p>Published Posts, newest first.</p></div></header><section class="shell content-stack"><div class="post-grid">{publicExport.posts.map((post) => <PostCard post={post} />)}</div></section></SiteLayout>

