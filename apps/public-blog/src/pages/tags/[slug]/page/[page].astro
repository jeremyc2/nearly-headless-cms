---
import PaginatedPostList from "../../../../components/paginated-post-list.astro"
import { tagArchivePaths } from "../../../../domain/archive-pages.ts"
import SiteLayout from "../../../../layouts/site-layout.astro"

export const getStaticPaths = tagArchivePaths
const { page, tag } = Astro.props
---

<SiteLayout title={`${tag.name} · Page ${page.pageNumber}`}>
  <PaginatedPostList
    basePath={`/tags/${tag.slug}`}
    label="Tag"
    page={page}
    title={`#${tag.name}`}
  />
</SiteLayout>
