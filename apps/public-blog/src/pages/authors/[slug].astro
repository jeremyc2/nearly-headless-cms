---
import PostCard from "../../components/PostCard.astro"
import RichText from "../../components/RichText.astro"
import { publicExport } from "../../data/public-export.ts"
import SiteLayout from "../../layouts/SiteLayout.astro"
export function getStaticPaths() { return publicExport.authors.map((author) => ({ params: { slug: author.slug }, props: { author } })) }
const { author } = Astro.props,
 posts = publicExport.posts.filter((post) => post.author === author.id)
---
<SiteLayout title={author.name}><header class="listing-header"><div class="shell narrow"><p class="eyebrow">Author</p><h1>{author.name}</h1><p>{author.biography}</p>{author.profile && <div class="author-profile"><RichText nodes={author.profile.children} /></div>}</div></header><section class="shell content-stack"><div class="section-heading"><h2>Field notes by {author.name}</h2></div><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></section></SiteLayout>

