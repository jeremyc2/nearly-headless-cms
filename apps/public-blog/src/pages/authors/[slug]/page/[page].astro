---
import PaginatedPostList from "../../../../components/paginated-post-list.astro"
import { authorArchivePaths } from "../../../../domain/archive-pages.ts"
import SiteLayout from "../../../../layouts/site-layout.astro"

export const getStaticPaths = authorArchivePaths
const { author, page } = Astro.props
---

<SiteLayout title={`${author.name} · Page ${page.pageNumber}`}>
  <PaginatedPostList
    basePath={`/authors/${author.slug}`}
    label="Author"
    page={page}
    title={author.name}
  />
</SiteLayout>
