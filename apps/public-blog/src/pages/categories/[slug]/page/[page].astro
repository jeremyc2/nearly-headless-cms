---
import Pagination from "../../../../components/Pagination.astro"
import PostCard from "../../../../components/PostCard.astro"
import { publicExport } from "../../../../data/public-export.ts"
import { paginate } from "../../../../domain/public-model.ts"
import SiteLayout from "../../../../layouts/SiteLayout.astro"

export function getStaticPaths() {
  return publicExport.categories.flatMap((category) => paginate(publicExport.posts.filter((post) => post.categories.includes(category.id)), 6).map((page) => ({
    params: { page: String(page.pageNumber), slug: category.slug },
    props: { category, page }
  })))
}
const { category, page } = Astro.props
---
<SiteLayout title={`${category.name} · Page ${page.pageNumber}`}><header class="listing-header"><div class="shell"><p class="eyebrow">Category</p><h1>{category.name}</h1></div></header><section class="shell content-stack"><div class="post-grid">{page.items.map((post) => <PostCard post={post} />)}</div><Pagination basePath={`/categories/${category.slug}`} previousPage={page.previousPage} nextPage={page.nextPage} /></section></SiteLayout>
