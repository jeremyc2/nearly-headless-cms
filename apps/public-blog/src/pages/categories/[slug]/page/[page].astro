---
import PaginatedPostList from "../../../../components/paginated-post-list.astro"
import { categoryArchivePaths } from "../../../../domain/archive-pages.ts"
import SiteLayout from "../../../../layouts/site-layout.astro"

export const getStaticPaths = categoryArchivePaths
const { category, page } = Astro.props
---

<SiteLayout title={`${category.name} · Page ${page.pageNumber}`}>
  <PaginatedPostList
    basePath={`/categories/${category.slug}`}
    label="Category"
    page={page}
    title={category.name}
  />
</SiteLayout>
