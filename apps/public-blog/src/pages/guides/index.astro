---
import SiteLayout from "../../layouts/site-layout.astro"

const guides = [
  {
    description: "Install the library, wire one layer, create your first entry.",
    href: "/guides/getting-started/",
    title: "Getting started",
  },
  {
    description: "Describe posts, authors, and tags in one TypeScript file.",
    href: "/guides/defining-content/",
    title: "Define your content",
  },
  {
    description: "Plug in storage, identity, and auth one file at a time.",
    href: "/guides/providing-layers/",
    title: "Provide layers",
  },
  {
    description: "Fetch a public export at build time and render pages.",
    href: "/guides/building-a-site/",
    title: "Build a content site",
  },
]
---
<SiteLayout title="Guides" description="Build your own headless CMS and a site that reads from it.">
  <section class="hero shell narrow">
    <p class="eyebrow">Nearly Headless CMS</p>
    <h1>Guides for CMS builders</h1>
    <p class="hero-intro">
      You bring storage, auth, and templates. The library handles entries, queries, and APIs.
      These pages follow the same path the Example CMS and this blog use.
    </p>
  </section>
  <div class="shell content-stack guide-index">
    {guides.map((guide) => (
      <article class="guide-card">
        <h2><a href={guide.href}>{guide.title}</a></h2>
        <p>{guide.description}</p>
        <a class="read-link" href={guide.href}>Read guide →</a>
      </article>
    ))}
  </div>
</SiteLayout>
