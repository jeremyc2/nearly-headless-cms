---
import { assetById, authorById } from "../../core/data/public-export.ts"
interface Props {
  readonly post: Record<string, unknown>
  readonly featured?: boolean
}
const { post, featured = false } = Astro.props,
 postAsset = assetById.get(String(post["featuredAsset"] ?? "")),
 postAuthor = authorById.get(String(post["author"]))
---
<article class:list={["post-card", { featured }]}>
  {postAsset?.localPath && <a class="post-image" href={`/posts/${String(post["slug"])}/`} tabindex="-1"><img src={postAsset.localPath} alt={String(post["featuredAlternativeText"] ?? "")} width={postAsset.metadata.width} height={postAsset.metadata.height} /></a>}
  <div class="post-card-body"><p class="post-meta"><time datetime={String(post["publishedAt"])}>{new Date(String(post["publishedAt"])).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</time>{postAuthor && <> · <a href={`/authors/${String(postAuthor["slug"])}/`}>{String(postAuthor["name"])}</a></>}</p><h2><a href={`/posts/${String(post["slug"])}/`}>{String(post["title"])}</a></h2><p>{String(post["excerpt"])}</p><a class="read-link" href={`/posts/${String(post["slug"])}/`}>Read field note <span aria-hidden="true">→</span></a></div>
</article>
