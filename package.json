{
  "name": "nearly-headless-cms-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev": "bun run --no-orphans --parallel --filter '*' dev",
    "build": "bun run --filter '*' build",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run check:escape-hatches",
    "lint": "oxlint . --fix --deny-warnings --format=agent",
    "lint:pretty": "oxlint . --fix --deny-warnings",
    "lint:stats": "bun lint:pretty | tail -n 2",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:unit": "bun test packages/nearly-headless-cms/test/unit apps/example-cms/test/unit apps/public-blog/test/unit",
    "test:types": "bun run --cwd packages/nearly-headless-cms test:types",
    "test:contract": "bun test packages/nearly-headless-cms/test/contract",
    "test:integration": "bun test packages/nearly-headless-cms/test/integration apps/example-cms/test/integration apps/public-blog/test/integration",
    "test:filesystem": "bun test packages/nearly-headless-cms/test/filesystem",
    "test:webview": "bun test acceptance/webview/qualification.test.ts && bun test acceptance/webview/journey.test.ts",
    "test:visual": "bun test acceptance/visual",
    "test:a11y": "bun test acceptance/accessibility",
    "test:journeys": "bun test acceptance/journeys",
    "check:generated": "bun run scripts/check-generated.ts",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "check:escape-hatches": "bun run scripts/escape-hatches.ts verify",
    "acceptance": "bun run scripts/run-acceptance.ts",
    "release": "bun run scripts/release.ts",
    "format": "oxfmt --write package.json tsconfig.json README.md packages apps/example-cms/package.json apps/example-cms/tsconfig.json apps/example-cms/scripts apps/example-cms/src apps/example-cms/test apps/public-blog/package.json apps/public-blog/tsconfig.json apps/public-blog/astro.config.ts apps/public-blog/src apps/public-blog/test acceptance scripts docs/releasing.md"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@types/bun": "1.4.0",
    "axe-core": "4.10.3",
    "oxfmt": "0.32.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111",
    "nearly-headless-cms": "workspace:*"
  }
}
